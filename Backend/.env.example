# ============================================
# SERVER
# ============================================
PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ============================================
# DATABASE (MongoDB)
# Used in: src/config/database.js
# Example: mongodb+srv://<user>:<pass>@cluster.mongodb.net/perplexity
# or:      mongodb://localhost:27017/perplexity
# ============================================
MONGODB_URI=

# ============================================
# JWT
# Used in: auth.controller.js, auth.middleware.js
# Signs both auth tokens (7d) and email-verification tokens.
# Use a long random string (e.g. `openssl rand -hex 32`)
# ============================================
JWT_SECRET=

# ============================================
# EMAIL (Gmail OAuth2 via Nodemailer)
# Used in: src/services/mail.service.js
# These come from Google Cloud Console -> OAuth 2.0 credentials,
# plus a refresh token obtained for the sender Gmail account.
# ============================================
GOOGLE_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ============================================
# AI PROVIDERS
# Used in: src/services/ai.service.js
# ============================================
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral AI — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ============================================
# WEB SEARCH
# Used in: src/services/internet.service.js (Tavily tool)
# Get key at https://app.tavily.com
# ============================================
TAVILY_API_KEY=
